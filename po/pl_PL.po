#: src/preferences.py:27
msgid "General"
msgstr "Ogólne"

#: src/preferences.py:32
msgid "AppImage default location"
msgstr "Domyślne położenie plików AppImage"

#: src/preferences.py:97
msgid "Use executable name for integrated terminal apps"
msgstr "Nazywanie aplikacji terminala nazwą pliku wykonywalnego"

#: src/preferences.py:99
msgid ""
"If enabled, apps that run in the terminal are renamed as their executable.\n"
"You would need to add the aforementioned folder to your $PATH manually.\n"
"\n"
"For example, \"golang_x86_64.appimage\" will be saved as \"go\""
msgstr ""
"Po włączeniu tej funkcji aplikacje działające w terminalu są zapisywane pod nazwą swojego pliku wykonywalnego.\n"
"Wspomniany katalog należy ręcznie dodać do zmiennej $PATH.\n"
"\n"
"Na przykład plik „golang_x86_64.appimage” zostanie zapisany jako „go”"

#: src/preferences.py:41
msgid "Show integrated AppImages outside the default folder"
msgstr "Wyświetlanie zintegrowanych plików AppImage spoza domyślnego katalogu"

#: src/preferences.py:43
msgid ""
"List AppImages that have been integrated into the system menu but are located"
" outside the default folder"
msgstr ""
"Wyświetla pliki AppImage zintegrowane z menu systemu, ale znajdujące się poza"
" domyślnym katalogiem"

#: src/preferences.py:61
msgid "File management"
msgstr "Zarządzanie plikami"

#: src/preferences.py:63
msgid "Move AppImages into the destination folder"
msgstr "Przenoszenie plików AppImage do katalogu docelowego"

#: src/preferences.py:64
msgid "Reduce disk usage"
msgstr "Zmniejsza wykorzystanie dysku"

#: src/preferences.py:68
msgid "Clone AppImages into the destination folder"
msgstr "Kopiowanie plików AppImage do katalogu docelowego"

#: src/preferences.py:69
msgid "Keep the original file and create a copy in the destination folder"
msgstr "Zachowuje oryginalny plik i tworzy kopię w katalogu docelowym"

#: src/preferences.py:119
msgid "Debugging"
msgstr "Debugowanie"

#: src/preferences.py:121
msgid "Enable debug logs"
msgstr "Komunikaty debugowania w dzienniku"

#: src/preferences.py:123
msgid ""
"Increases log verbosity, occupying more disk space and potentially impacting performance.\n"
"Requires a restart."
msgstr ""
"Zwiększa szczegółowość dziennika, co zajmuje więcej miejsca na dysku i może obniżyć wydajność.\n"
"Wymaga ponownego uruchomienia."

#: src/WelcomeScreen.py:114
msgid "The folder must be in your home directory"
msgstr "Katalog musi się znajdować w katalogu domowym"

#: src/preferences.py:152 src/WelcomeScreen.py:117
msgid "Select a folder"
msgstr "Wybierz katalog"

