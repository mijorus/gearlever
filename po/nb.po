msgstr "Generelt"

#: src/gtk/help-overlay.ui:14
msgctxt "shortcut window"
msgid "Show Shortcuts"
msgstr "Vis snarveier"

#: src/gtk/help-overlay.ui:20
msgctxt "shortcut window"
msgid "Quit"
