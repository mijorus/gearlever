msgstr "Det finnes allerede en app med samme navn. Hvordan vil du fortsette?"

#: src/components/AppDetailsConflictModal.py:17
msgid "Keep both"
msgstr "Behold begge"

#: src/components/AppDetailsConflictModal.py:19
msgid "Replace"
msgstr "Erstatt"

